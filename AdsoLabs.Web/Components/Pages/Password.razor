@page "/password"
@using System.Diagnostics
@attribute [AllowAnonymous]
@using AdsoLabs.Application.DTOs.Auth
@using AdsoLabs.Web.Components.Layout
@using AdsoLabs.Web.Services
@using AdsoLabs.Web.Services.Api
@rendermode InteractiveServer
@layout LoginLayout
@inject NavigationManager nav
@inject AuthApiService AuthApiService
@inject SesionService SesionService
@inject NavigationManager navigation

<div class="auth-split">

    <div class="auth-panel-left">
        <img class="auth-logo" src="images/Logo.png" alt="ADSO Labs" />
        <img class="auth-illustration" src="images/seguridad.png" alt="" aria-hidden="true" />
        <p class="auth-quote">
            &ldquo;We engineer scalable software with architectural precision,
            turning complex needs into intelligent digital solutions.&rdquo;
        </p>
        <img class="auth-bg" src="images/Gradient_Login.png" alt="" aria-hidden="true" />
    </div>

    <div class="auth-panel-right">
        <div class="auth-card">

            <div class="auth-card-header">
                <h1 class="auth-title">¿Olvidaste tu contraseña?</h1>
                <p class="auth-subtitle">
                    La recuperación comienza con el correo electrónico
                    vinculado a tu cuenta.
                </p>
            </div>

            <div class="auth-field">
                <label class="auth-label">Correo electrónico</label>
                <div class="auth-input-group">
                    <i class="bi bi-envelope-open"></i>
                    <input @bind="correo" placeholder="usuario@soy.sena.edu.co" />
                </div>
            </div>

            @if (peticion != null)
            {
                <p class="auth-alert">@peticion.Mensaje</p>
            }

            <button class="auth-btn-primary" @onclick="EnviarTokenAsync" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <i class="bi bi-send"></i>
                    <span>Enviar correo de recuperación</span>
                }
            </button>

            <a class="auth-link" href="/" style="text-align:center;">
                <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
            </a>

        </div>
    </div>

</div>

@code {

    protected override void OnInitialized()
    {
        if (SesionService.EstaAutenticado)
        {
            navigation.NavigateTo("/logouthandler", forceLoad: true);
        }
    }

}


@code {

    private EnviarTokenResultadoDto? peticion = null;
    private bool cargando = false;
    string correo = "";

    async Task EnviarTokenAsync()
    {

        peticion = null;
        cargando = true;

        if (string.IsNullOrEmpty(correo))
        {
            peticion.Mensaje = "No pueden haber campos vacios";
            return;
        }

        peticion = await AuthApiService.EnviarTokenAsync(new EnviarTokenDto() { Correo = correo });
        cargando = false;


    }
}