@page "/aprendices/{IdAprendiz:int}/informe"
@using AdsoLabs.Application.DTOs.Aprendiz
@using AdsoLabs.Application.DTOs.Fichas
@using AdsoLabs.Application.DTOs.Informe
@using AdsoLabs.Web.Services
@using AdsoLabs.Web.Services.Api
@attribute [Authorize(Roles = "Administrador,Instructor")]
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager nav
@inject InformeAprendizApiService InformeApi
@inject FichaApiService FichaApi
@inject SesionService SesionService
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

@if (!cargando && aprendiz is not null)
{
<section class="informe">
	<h1>Informe Academico</h1>
	<h2>Datos e informacion academica de los aprendices</h2>

	<div class="contenedor-informe">
		<div class="informe-aprendiz">
			<div class="order-informer">
				<div class="container-user">
					<div class="user-icons"></div>
					<div class="user">
						<h2>@aprendiz.Nombres @aprendiz.Apellidos</h2>
						<h3>Ficha: <p>@(aprendiz.Ficha.FirstOrDefault() ?? "--")</p></h3>
					</div>
				</div>
				<div class="progress-row">
					<div class="progress-block">
						<span class="progress-label">Progreso</span>
						<div class="progress-bar-track">
							<div class="progress-bar-fill" style="width: @(fichaDetalle?.ProgresoGeneral ?? 0)%;"></div>
						</div>
						<span class="progress-percent">@(fichaDetalle?.ProgresoGeneral ?? 0)%</span>
					</div>
					<div class="estado">
						<span class="progress-label">Estado</span>
						<div class="estado-badge">
							<span class="check-icon">✓</span>
							<span>@aprendiz.Estado</span>
						</div>
					</div>
					<div class="estado">
						<span class="progress-label">Asistencia</span>
						<span class="indicador-informe @(aprendiz.IndicadorAsistencia == "Al día" ? "indicador-informe-al-dia" : "indicador-informe-atrasado")"
							  title="@aprendiz.PorcentajeAsistencia% de sesiones asistidas">
							@aprendiz.IndicadorAsistencia · @aprendiz.PorcentajeAsistencia%
						</span>
					</div>
				</div>
			</div>

			<div class="tabs-container">
				<button class="tab @(TabActivo == "personal" ? "tab-activo" : "")"
						@onclick='() => TabActivo = "personal"'>
					Datos Personales
				</button>
				<button class="tab @(TabActivo == "acudientes" ? "tab-activo" : "")"
						@onclick='() => TabActivo = "acudientes"'>
					Datos Acudientes
				</button>
				<button class="tab @(TabActivo == "observaciones" ? "tab-activo" : "")"
						@onclick='() => TabActivo = "observaciones"'>
					Observaciones
				</button>
			</div>

			@* ── Tab 1: Datos Personales ── *@
			@if (TabActivo == "personal")
			{
				<div class="contenedor-complete">
					<div class="information-personal">
						<div class="datos-card">
							<div class="dato-fila">
								<span class="dato-label">Documento:</span>
								<span class="dato-valor">@(aprendiz.NumeroDocumento ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Teléfono de Contacto:</span>
								<span class="dato-valor">@(aprendiz.Telefono ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Tipo de Documento:</span>
								<span class="dato-valor">@(aprendiz.TipoDocumento ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Fecha de Nacimiento:</span>
								<span class="dato-valor">@(aprendiz.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Dirección de Residencia:</span>
								<span class="dato-valor">@(aprendiz.Direccion ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Municipio:</span>
								<span class="dato-valor">@(aprendiz.Municipio ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Estado:</span>
								<span class="dato-valor">@(aprendiz.Estado ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Tipo de Población:</span>
								<span class="dato-valor">@(aprendiz.TipoPoblacion ?? "--")</span>
							</div>
							<div class="dato-fila">
								<span class="dato-label">Condición Especial:</span>
								<span class="dato-valor">@(aprendiz.CondicionEspecial ?? "--")</span>
							</div>
						</div>
						<div class="seguimiento-academico">
							<h1>Seguimiento Academico</h1>
							<div class="control-aprendiz">
								<div class="contrato">
									<h1>Contrato<br />Academico</h1>
									<h3>@(aprendizFicha is not null ? (aprendizFicha.TienePatrocinio ? "SI" : "NO") : "--")</h3>
								</div>
								<div class="programadas">
									<h1>Competencias<br />Programadas</h1>
									<h3>@CompetenciasProgramadasCount</h3>
								</div>
								<div class="en-curso">
									<h1>Competencias<br />En Curso</h1>
									<h3>@CompetenciasEnCursoCount</h3>
								</div>
								<div class="sin-calificar">
									<h1>Competencias<br />Sin Calificar</h1>
									<h3>@CompetenciasSinCalificarCount</h3>
								</div>
							</div>
						</div>
					</div>
					<div class="linea"></div>
					<h1 class="aviso">Avisos:</h1>
					<div class="container-aviso">
						@* TODO: Los avisos requieren datos de juicios evaluativos por aprendiz+competencia.
						   Solo deben mostrarse cuando competencia.Estado == "Vista" Y el aprendiz
						   no tiene juicios en esa competencia. El DTO actual (AprendizDetalleDTO) no expone
						   esa información. Pendiente: agregar endpoint o campo en DTO que exponga los
						   juicios por aprendiz para poder filtrar correctamente. *@
						@if (!AvisosActivos.Any())
						{
							<p style="color:#6B7280;font-family:'Roboto',sans-serif;padding:10px 20px;">Sin avisos pendientes.</p>
						}
						else
						{
							@foreach (var aviso in AvisosActivos)
							{
								<div class="avisos">
									<div class="barra"></div>
									<div class="info-aviso">
										<h1>@aviso.Titulo</h1>
										<h3>@aviso.Descripcion</h3>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<div class="button-group">
					<button class="cerrar" @onclick="Volver">Cerrar</button>
					<button class="descargar" @onclick="DescargarPDF">
						Descargar Informe <i class="bi bi-cloud-download"></i>
					</button>
				</div>
			}

			@* ── Tab 2: Datos Acudientes ── *@
			else if (TabActivo == "acudientes")
			{
				<div class="contenedor-complete">
					<div class="information-personal">
						<div class="datos-card">

							@if (!modoEdicionAcudiente)
							{
								@if (acudiente is null)
								{
									<p style="color:#6B7280;font-family:'Roboto',sans-serif;padding:20px;">
										No hay información de acudiente registrada.
									</p>
								}
								else
								{
									<div class="dato-fila">
										<span class="dato-label">Nombre Acudiente:</span>
										<span class="dato-valor">@acudiente.Nombre</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Parentesco:</span>
										<span class="dato-valor">@acudiente.Parentesco</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Correo Electrónico:</span>
										<span class="dato-valor link">@(acudiente.Correo ?? "--")</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Teléfono de Contacto:</span>
										<span class="dato-valor">@acudiente.Telefono</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Género:</span>
										<span class="dato-valor">@(acudiente.Genero ?? "--")</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Tipo de Documento:</span>
										<span class="dato-valor">@(acudiente.TipoDocumento ?? "--")</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Número de Documento:</span>
										<span class="dato-valor">@(acudiente.NumeroDocumento ?? "--")</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Dirección de Residencia:</span>
										<span class="dato-valor">@(acudiente.Direccion ?? "--")</span>
									</div>
									<div class="dato-fila">
										<span class="dato-label">Estrato Socioeconomico:</span>
										<span class="dato-valor">@(acudiente.Estrato?.ToString() ?? "--")</span>
									</div>
								}
							}
							else
							{
								@* ── Formulario de acudiente ── *@
								<div class="dato-fila">
									<span class="dato-label">Nombre Acudiente:</span>
									<div class="campo-input">
										<input class="form-input-modal" type="text"
											   placeholder="Nombre completo"
											   @bind="acudienteForm.NombreAcudiente" />
										@if (errNombreAcudiente)
										{ <span class="error-campo">Campo requerido</span> }
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Parentesco:</span>
									<div class="campo-input">
										<select class="form-input-modal" @bind="acudienteForm.Parentesco">
											<option value="">Seleccione...</option>
											@foreach (var p in Parentescos)
											{ <option value="@p">@p</option> }
										</select>
										@if (errParentescoAcudiente)
										{ <span class="error-campo">Campo requerido</span> }
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Correo Electrónico:</span>
									<div class="campo-input">
										<input class="form-input-modal" type="email"
											   placeholder="correo@ejemplo.com"
											   @bind="acudienteForm.Correo" />
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Teléfono de Contacto:</span>
									<div class="campo-input">
										<input class="form-input-modal" type="text"
											   placeholder="3XXXXXXXXX"
											   @bind="acudienteForm.Telefono" />
										@if (errTelefonoAcudiente)
										{ <span class="error-campo">Campo requerido</span> }
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Género:</span>
									<div class="campo-input">
										<select class="form-input-modal" @bind="acudienteForm.Genero">
											<option value="">Seleccione...</option>
											@foreach (var g in Generos)
											{ <option value="@g">@g</option> }
										</select>
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Tipo de Documento:</span>
									<div class="campo-input">
										<select class="form-input-modal" @bind="acudienteForm.TipoDocumento">
											<option value="">Seleccione...</option>
											@foreach (var td in TiposDoc)
											{ <option value="@td">@td</option> }
										</select>
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Número de Documento:</span>
									<div class="campo-input">
										<input class="form-input-modal" type="text"
											   placeholder="Número de documento"
											   @bind="acudienteForm.NumeroDocumento" />
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Dirección de Residencia:</span>
									<div class="campo-input">
										<input class="form-input-modal" type="text"
											   placeholder="Calle, carrera, número..."
											   @bind="acudienteForm.Direccion" />
									</div>
								</div>
								<div class="dato-fila">
									<span class="dato-label">Estrato Socioeconomico:</span>
									<div class="campo-input">
										<select class="form-input-modal" @bind="acudienteForm.EstratoStr">
											<option value="">Seleccione...</option>
											@foreach (var e in Estratos)
											{ <option value="@e">@e</option> }
										</select>
									</div>
								</div>

								@if (!string.IsNullOrEmpty(mensajeAcudiente))
								{
									<p style="padding:10px 20px;font-family:'Roboto',sans-serif;font-size:14px;color:#1D8F06;">
										@mensajeAcudiente
									</p>
								}
							}

						</div>
						<div class="seguimiento-academico">
							<h1>Seguimiento Academico del Aprendiz</h1>
							<div class="control-aprendiz">
								<div class="contrato">
									<h1>Contrato<br />Academico</h1>
									<h3>@(aprendizFicha is not null ? (aprendizFicha.TienePatrocinio ? "SI" : "NO") : "--")</h3>
								</div>
								<div class="programadas">
									<h1>Competencias<br />Programadas</h1>
									<h3>@CompetenciasProgramadasCount</h3>
								</div>
								<div class="en-curso">
									<h1>Competencias<br />En Curso</h1>
									<h3>@CompetenciasEnCursoCount</h3>
								</div>
								<div class="sin-calificar">
									<h1>Competencias<br />Sin Calificar</h1>
									<h3>@CompetenciasSinCalificarCount</h3>
								</div>
							</div>
						</div>
					</div>
					<div class="linea"></div>
					<h1 class="aviso">Avisos:</h1>
					<div class="container-aviso">
						@if (!AvisosActivos.Any())
						{
							<p style="color:#6B7280;font-family:'Roboto',sans-serif;padding:10px 20px;">Sin avisos pendientes.</p>
						}
						else
						{
							@foreach (var aviso in AvisosActivos)
							{
								<div class="avisos">
									<div class="barra"></div>
									<div class="info-aviso">
										<h1>@aviso.Titulo</h1>
										<h3>@aviso.Descripcion</h3>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<div class="button-group">
					<button class="cerrar" @onclick="CancelarEdicionAcudiente">
						@(modoEdicionAcudiente ? "Cancelar" : "Cerrar")
					</button>
					@if (modoEdicionAcudiente)
					{
						<button class="descargar" @onclick="GuardarAcudiente" disabled="@guardandoAcudiente">
							@(guardandoAcudiente ? "Guardando..." : "Guardar acudiente")
						</button>
					}
					else
					{
						<button class="descargar" style="background:#6B7280;"
								@onclick="IniciarEdicionAcudiente">
							@(acudiente is null ? "Agregar acudiente" : "Editar acudiente")
						</button>
						<button class="descargar" @onclick="DescargarPDF">
							Descargar Informe <i class="bi bi-cloud-download"></i>
						</button>
					}
				</div>
			}

			@* ── Tab 3: Observaciones ── *@
			else if (TabActivo == "observaciones")
			{
				<div class="contenedor-complete">

					@* ── Nueva observación ── *@
					<div class="observacion-container">
						<div class="top-bar">
							<span class="observacion-title">Nueva Observación:</span>
							<span class="observacion-caracter">@nuevaObs.Length/500</span>
						</div>
						<div class="observacion-box">
							<div class="barra"></div>
							<textarea value="@nuevaObs"
									  @oninput="LimitarNuevaObs"
									  placeholder="Escribe una observación sobre el aprendiz..."
									  maxlength="500"></textarea>
						</div>
					</div>

					@if (!string.IsNullOrEmpty(errorObs))
					{
						<p style="color:#DE422A;font-family:'Roboto',sans-serif;font-size:13px;padding:4px 8px;">
							@errorObs
						</p>
					}

					<div class="linea"></div>

					@* ── Historial ── *@
					<h1 class="aviso">Historial de Observaciones:</h1>
					<div class="container-aviso observaciones-list">
						@if (!observaciones.Any())
						{
							<p style="color:#6B7280;font-family:'Roboto',sans-serif;padding:10px 20px;">No hay observaciones registradas.</p>
						}
						else
						{
							@foreach (var obs in observaciones)
							{
								<div class="avisos">
									<div class="barra" style="background:#3B82F6;"></div>
									<div class="info-aviso">
										<h1>@obs.NombreUsuario — @obs.Fecha.ToString("dd/MM/yyyy HH:mm")</h1>
										<h3>@obs.Descripcion</h3>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<div class="button-group">
					<button class="cerrar" @onclick="Volver">Cerrar</button>
					<button class="descargar"
							@onclick="AgregarObservacion"
							disabled="@(guardandoObs || string.IsNullOrWhiteSpace(nuevaObs))">
						@(guardandoObs ? "Guardando..." : "Agregar observación")
					</button>
					<button class="descargar" @onclick="DescargarPDF">
						Descargar Informe <i class="bi bi-cloud-download"></i>
					</button>
				</div>
			}

		</div>
	</div>
    @* ── Plantilla PDF institucional (oculta en pantalla, capturada al generar PDF) ── *@
    <div id="informe-pdf" class="pdf-doc">

        @* Encabezado *@
        <div class="pdf-header">
            <div class="pdf-header-brand">
                <div class="pdf-logo-icon">A</div>
                <div class="pdf-logo-text">
                    <span class="pdf-logo-name">ADSO Labs</span>
                    <span class="pdf-logo-sub">Programa ADSO — SENA</span>
                </div>
            </div>
            <div class="pdf-header-meta">
                <span class="pdf-header-title">Informe Académico</span>
                <span class="pdf-header-date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <div class="pdf-divider-accent"></div>

        @* Identificación del aprendiz *@
        <div class="pdf-section pdf-id-row">
            <div class="pdf-avatar-large"></div>
            <div class="pdf-id-info">
                <h2 class="pdf-aprendiz-nombre">@aprendiz!.Nombres @aprendiz.Apellidos</h2>
                <p class="pdf-aprendiz-doc">@(aprendiz.TipoDocumento ?? "Documento") &nbsp;·&nbsp; @(aprendiz.NumeroDocumento ?? "--")</p>
                <p class="pdf-aprendiz-ficha">Ficha: <strong>@(aprendiz.Ficha.FirstOrDefault() ?? "--")</strong></p>
            </div>
            <div class="pdf-id-badges">
                <span class="pdf-estado-badge">@aprendiz.Estado</span>
                @if (aprendizFicha is not null && aprendizFicha.TienePatrocinio)
                {
                    <span class="pdf-patrocinio-badge">Con patrocinio</span>
                }
            </div>
        </div>

        @* Resumen ejecutivo *@
        <div class="pdf-section">
            <div class="pdf-section-title">Resumen Ejecutivo</div>
            <div class="pdf-resumen-row">
                <div class="pdf-progreso-bloque">
                    <span class="pdf-prog-label">Progreso general</span>
                    <div class="pdf-prog-track">
                        <div class="pdf-prog-fill" style="width:@(fichaDetalle?.ProgresoGeneral ?? 0)%;"></div>
                    </div>
                    <span class="pdf-prog-pct">@(fichaDetalle?.ProgresoGeneral ?? 0)%</span>
                </div>
            </div>
            <div class="pdf-kpi-grid">
                <div class="pdf-kpi pdf-kpi-indigo">
                    <span class="pdf-kpi-label">Competencias<br>Programadas</span>
                    <span class="pdf-kpi-value">@CompetenciasProgramadasCount</span>
                </div>
                <div class="pdf-kpi pdf-kpi-blue">
                    <span class="pdf-kpi-label">Competencias<br>En Curso</span>
                    <span class="pdf-kpi-value">@CompetenciasEnCursoCount</span>
                </div>
                <div class="pdf-kpi pdf-kpi-red">
                    <span class="pdf-kpi-label">Sin<br>Calificar</span>
                    <span class="pdf-kpi-value">@CompetenciasSinCalificarCount</span>
                </div>
                <div class="pdf-kpi pdf-kpi-gray">
                    <span class="pdf-kpi-label">Contrato<br>Académico</span>
                    <span class="pdf-kpi-value">@(aprendizFicha is not null ? (aprendizFicha.TienePatrocinio ? "Sí" : "No") : "--")</span>
                </div>
            </div>
        </div>

        @* Datos personales *@
        <div class="pdf-section">
            <div class="pdf-section-title">Datos Personales</div>
            <table class="pdf-tabla">
                <tr>
                    <td class="pdf-td-label">Tipo de documento</td>
                    <td class="pdf-td-valor">@(aprendiz.TipoDocumento ?? "--")</td>
                    <td class="pdf-td-label">Número de documento</td>
                    <td class="pdf-td-valor">@(aprendiz.NumeroDocumento ?? "--")</td>
                </tr>
                <tr>
                    <td class="pdf-td-label">Fecha de nacimiento</td>
                    <td class="pdf-td-valor">@(aprendiz.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "--")</td>
                    <td class="pdf-td-label">Teléfono de contacto</td>
                    <td class="pdf-td-valor">@(aprendiz.Telefono ?? "--")</td>
                </tr>
                <tr>
                    <td class="pdf-td-label">Municipio</td>
                    <td class="pdf-td-valor">@(aprendiz.Municipio ?? "--")</td>
                    <td class="pdf-td-label">Dirección de residencia</td>
                    <td class="pdf-td-valor">@(aprendiz.Direccion ?? "--")</td>
                </tr>
                <tr>
                    <td class="pdf-td-label">Tipo de población</td>
                    <td class="pdf-td-valor">@(aprendiz.TipoPoblacion ?? "--")</td>
                    <td class="pdf-td-label">Condición especial</td>
                    <td class="pdf-td-valor">@(aprendiz.CondicionEspecial ?? "--")</td>
                </tr>
            </table>
        </div>

        @* Datos del acudiente *@
        @if (acudiente is not null)
        {
            <div class="pdf-section">
                <div class="pdf-section-title">Datos del Acudiente</div>
                <table class="pdf-tabla">
                    <tr>
                        <td class="pdf-td-label">Nombre</td>
                        <td class="pdf-td-valor">@acudiente.Nombre</td>
                        <td class="pdf-td-label">Parentesco</td>
                        <td class="pdf-td-valor">@acudiente.Parentesco</td>
                    </tr>
                    <tr>
                        <td class="pdf-td-label">Teléfono</td>
                        <td class="pdf-td-valor">@acudiente.Telefono</td>
                        <td class="pdf-td-label">Correo</td>
                        <td class="pdf-td-valor">@(acudiente.Correo ?? "--")</td>
                    </tr>
                </table>
            </div>
        }

        @* Avisos académicos *@
        <div class="pdf-section">
            <div class="pdf-section-title">Avisos Académicos</div>
            @if (!AvisosActivos.Any())
            {
                <p class="pdf-empty">Sin avisos pendientes.</p>
            }
            else
            {
                @foreach (var aviso in AvisosActivos)
                {
                    <div class="pdf-aviso">
                        <div class="pdf-aviso-barra"></div>
                        <div class="pdf-aviso-content">
                            <span class="pdf-aviso-titulo">@aviso.Titulo</span>
                            <span class="pdf-aviso-desc">@aviso.Descripcion</span>
                        </div>
                    </div>
                }
            }
        </div>

        @* Observaciones *@
        <div class="pdf-section">
            <div class="pdf-section-title">Observaciones Registradas</div>
            @if (!observaciones.Any())
            {
                <p class="pdf-empty">No hay observaciones registradas.</p>
            }
            else
            {
                @foreach (var obs in observaciones.Take(5))
                {
                    <div class="pdf-aviso">
                        <div class="pdf-aviso-barra" style="background:#3B82F6;"></div>
                        <div class="pdf-aviso-content">
                            <span class="pdf-aviso-titulo">@obs.NombreUsuario &nbsp;—&nbsp; @obs.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="pdf-aviso-desc">@obs.Descripcion</span>
                        </div>
                    </div>
                }
                @if (observaciones.Count > 5)
                {
                    <p class="pdf-empty" style="margin-top:4px;">+ @(observaciones.Count - 5) observación(es) adicional(es) no mostrada(s) en este informe.</p>
                }
            }
        </div>

        @* Pie de página *@
        <div class="pdf-footer">
            <span>Generado automáticamente por ADSO Labs</span>
            <span>@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CO"))</span>
        </div>

    </div>
</section>
}

<script>
    async function descargarPDF() {
        const { jsPDF } = window.jspdf;
        const element = document.getElementById("informe-pdf");

        // 1. Mostrar temporalmente el documento PDF
        element.style.display = "block";

        // 2. Esperar que el DOM pinte
        await new Promise(r => setTimeout(r, 250));

        // 3. Capturar
        const canvas = await html2canvas(element, {
            scale: 2,
            useCORS: true,
            backgroundColor: "#ffffff"
        });

        // 4. Ocultar de nuevo
        element.style.display = "none";

        const imgData = canvas.toDataURL("image/png");
        const pdf = new jsPDF("p", "mm", "a4");

        const imgWidth  = 210;
        const pageHeight = 297;
        const imgHeight  = canvas.height * imgWidth / canvas.width;
        let   heightLeft = imgHeight;
        let   position   = 0;

        pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;

        while (heightLeft > 0) {
            position = heightLeft - imgHeight;
            pdf.addPage();
            pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
        }

        const fecha = new Date().toISOString().slice(0, 10);
        pdf.save(`informe_${fecha}.pdf`);
    }
</script>

@code {

    [Parameter] public int IdAprendiz { get; set; }

    // ── Estado de carga ─────────────────────────────────────────────────
    bool                             cargando                 = true;
    AprendizDetalleDTO?              aprendiz                 = null;
    FichaDetallesDTO?                fichaDetalle             = null;
    AprendizFichaDTO?                aprendizFicha            = null;
    List<CompetenciaFichaDTO>        competenciasFicha        = [];
    List<CompetenciaSinCalificarDTO> competenciasSinCalificar = [];
    AcudienteDTO?                    acudiente                = null;
    List<ObservacionAprendizDTO>     observaciones            = [];

    // ── Tabs ────────────────────────────────────────────────────────────
    private string TabActivo = "personal";

    // ── Contadores de seguimiento académico ─────────────────────────────
    // Competencias activas (Programada + En Curso + Vista)
    int CompetenciasProgramadasCount =>
        competenciasFicha.Count(c => c.Estado is "Programada" or "En Curso" or "Vista");
    // En ejecución actual: Programada o En Curso
    int CompetenciasEnCursoCount =>
        competenciasFicha.Count(c => c.Estado is "En Curso" or "Programada");
    // Competencias "Vista" donde el aprendiz no tiene juicios — cargadas desde backend
    int CompetenciasSinCalificarCount => competenciasSinCalificar.Count;

    // ── Avisos ──────────────────────────────────────────────────────────
    // Una competencia programada con juicios "Por Evaluar" cargados genera un aviso.
    class AvisoItem { public string Titulo { get; set; } = ""; public string Descripcion { get; set; } = ""; }
    IEnumerable<AvisoItem> AvisosActivos => competenciasSinCalificar
        .Select(c => new AvisoItem
        {
            Titulo      = c.NombreCompetencia,
            Descripcion = c.ResultadosPendientes.Count == 1
                ? $"Tiene 1 resultado por evaluar: {c.ResultadosPendientes[0]}."
                : $"Tiene {c.ResultadosPendientes.Count} resultados por evaluar: {string.Join(", ", c.ResultadosPendientes)}."
        });

    // ── Acudiente form ──────────────────────────────────────────────────
    class AcudienteFormModel
    {
        public string NombreAcudiente  { get; set; } = "";
        public string Parentesco       { get; set; } = "";
        public string Correo           { get; set; } = "";
        public string Telefono         { get; set; } = "";
        public string Genero           { get; set; } = "";
        public string TipoDocumento    { get; set; } = "";
        public string NumeroDocumento  { get; set; } = "";
        public string Direccion        { get; set; } = "";
        public string EstratoStr       { get; set; } = "";
    }

    AcudienteFormModel acudienteForm          = new();
    bool               modoEdicionAcudiente   = false;
    bool               guardandoAcudiente     = false;
    string             mensajeAcudiente       = "";
    bool               errNombreAcudiente     = false;
    bool               errParentescoAcudiente = false;
    bool               errTelefonoAcudiente   = false;

    static readonly string[] Parentescos = ["Madre", "Padre", "Hermano/a", "Tío/a", "Abuelo/a", "Otro"];
    static readonly string[] Generos     = ["Masculino", "Femenino", "Otro"];
    static readonly string[] TiposDoc    = ["Cédula de Ciudadanía", "Tarjeta de Identidad", "Pasaporte"];
    static readonly string[] Estratos    = ["1", "2", "3", "4", "5", "6"];

    // ── Observaciones (Tab 3) ────────────────────────────────────────────
    string nuevaObs    = "";
    bool   guardandoObs = false;
    string errorObs    = "";

    // ── Carga inicial ────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        aprendiz = null; fichaDetalle = null; acudiente = null;
        observaciones = []; competenciasSinCalificar = [];

        aprendiz = await InformeApi.ObtenerDatosAprendizAsync(IdAprendiz);
        if (aprendiz is null) { nav.NavigateTo("/home"); return; }

        if (aprendiz.Estado is "Cancelado" or "Retiro Voluntario" or "Trasladado")
        {
            nav.NavigateTo("/aprendiz", replace: true);
            return;
        }

        // Cargar detalles de ficha para la barra de progreso y tarjetas de seguimiento
        var numeroFicha = aprendiz.Ficha.FirstOrDefault();
        var tareaFicha           = numeroFicha is not null
            ? FichaApi.ObtenerDatosAsync(numeroFicha)
            : Task.FromResult<FichaDetallesDTO?>(null);
        var tareaAprendices      = numeroFicha is not null
            ? FichaApi.ObtenerAprendicesAsync(numeroFicha)
            : Task.FromResult(new List<AprendizFichaDTO>());
        var tareaCompetencias    = numeroFicha is not null
            ? FichaApi.ObtenerFichaCompetenciaAsync(numeroFicha)
            : Task.FromResult(new List<CompetenciaFichaDTO>());
        var tareaSinCalificar    = numeroFicha is not null
            ? InformeApi.ObtenerCompetenciasSinCalificarAsync(IdAprendiz, numeroFicha)
            : Task.FromResult(new List<CompetenciaSinCalificarDTO>());
        var tareaAcudiente       = InformeApi.ObtenerAcudienteAsync(IdAprendiz);
        var tareaObservaciones   = InformeApi.ObtenerObservacionesAsync(IdAprendiz);

        await Task.WhenAll(tareaFicha, tareaAprendices, tareaCompetencias,
                           tareaSinCalificar, tareaAcudiente, tareaObservaciones);

        fichaDetalle             = tareaFicha.Result;
        aprendizFicha            = tareaAprendices.Result.FirstOrDefault(a => a.IdAprendiz == IdAprendiz);
        competenciasFicha        = tareaCompetencias.Result;
        competenciasSinCalificar = tareaSinCalificar.Result;
        acudiente                = tareaAcudiente.Result;
        observaciones            = tareaObservaciones.Result;
        cargando                 = false;
    }

    // ── Navegación ───────────────────────────────────────────────────────
    private async Task Volver() => await JS.InvokeVoidAsync("history.back");

    // ── PDF ──────────────────────────────────────────────────────────────
    private async Task DescargarPDF() => await JS.InvokeVoidAsync("descargarPDF");

    // ── Acudiente ────────────────────────────────────────────────────────
    void IniciarEdicionAcudiente()
    {
        acudienteForm = acudiente is not null
            ? new AcudienteFormModel
            {
                NombreAcudiente = acudiente.Nombre,
                Parentesco      = acudiente.Parentesco,
                Correo          = acudiente.Correo ?? "",
                Telefono        = acudiente.Telefono,
                Genero          = acudiente.Genero ?? "",
                TipoDocumento   = acudiente.TipoDocumento ?? "",
                NumeroDocumento = acudiente.NumeroDocumento ?? "",
                Direccion       = acudiente.Direccion ?? "",
                EstratoStr      = acudiente.Estrato?.ToString() ?? ""
            }
            : new();
        errNombreAcudiente     = false;
        errParentescoAcudiente = false;
        errTelefonoAcudiente   = false;
        mensajeAcudiente       = "";
        modoEdicionAcudiente   = true;
    }

    void CancelarEdicionAcudiente()
    {
        if (!modoEdicionAcudiente)
        {
            // Botón "Cerrar" en modo lectura → volver
            _ = Volver();
            return;
        }
        modoEdicionAcudiente   = false;
        acudienteForm          = new();
        mensajeAcudiente       = "";
        errNombreAcudiente     = false;
        errParentescoAcudiente = false;
        errTelefonoAcudiente   = false;
    }

    private async Task GuardarAcudiente()
    {
        errNombreAcudiente     = string.IsNullOrWhiteSpace(acudienteForm.NombreAcudiente);
        errParentescoAcudiente = string.IsNullOrWhiteSpace(acudienteForm.Parentesco);
        errTelefonoAcudiente   = string.IsNullOrWhiteSpace(acudienteForm.Telefono);

        if (errNombreAcudiente || errParentescoAcudiente || errTelefonoAcudiente) return;

        guardandoAcudiente = true;
        mensajeAcudiente   = "";

        var dto = new GuardarAcudienteDTO
        {
            Nombre          = acudienteForm.NombreAcudiente.Trim(),
            Parentesco      = acudienteForm.Parentesco,
            Correo          = string.IsNullOrWhiteSpace(acudienteForm.Correo)          ? null : acudienteForm.Correo.Trim(),
            Telefono        = acudienteForm.Telefono.Trim(),
            Genero          = string.IsNullOrWhiteSpace(acudienteForm.Genero)          ? null : acudienteForm.Genero,
            TipoDocumento   = string.IsNullOrWhiteSpace(acudienteForm.TipoDocumento)   ? null : acudienteForm.TipoDocumento,
            NumeroDocumento = string.IsNullOrWhiteSpace(acudienteForm.NumeroDocumento) ? null : acudienteForm.NumeroDocumento.Trim(),
            Direccion       = string.IsNullOrWhiteSpace(acudienteForm.Direccion)       ? null : acudienteForm.Direccion.Trim(),
            Estrato         = byte.TryParse(acudienteForm.EstratoStr, out var est)     ? est  : null
        };

        // TODO: implementar endpoint POST /aprendiz/{id}/acudiente en AprendizController
        // El endpoint ya está disponible en InformeController: POST /api/aprendiz/{id}/acudiente
        var ok = await InformeApi.GuardarAcudienteAsync(IdAprendiz, dto);
        if (ok)
        {
            acudiente            = await InformeApi.ObtenerAcudienteAsync(IdAprendiz);
            modoEdicionAcudiente = false;
            mensajeAcudiente     = "";
        }
        else
        {
            mensajeAcudiente = "Funcionalidad en desarrollo. No se pudo guardar el acudiente.";
        }
        guardandoAcudiente = false;
    }

    // ── Observaciones (Tab 3) ────────────────────────────────────────────
    void LimitarNuevaObs(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? "";
        nuevaObs = texto.Length > 500 ? texto[..500] : texto;
    }

    private async Task AgregarObservacion()
    {
        errorObs = "";
        if (string.IsNullOrWhiteSpace(nuevaObs)) return;

        guardandoObs = true;
        var dto = new AgregarObservacionDTO
        {
            Descripcion = nuevaObs.Trim(),
            IdUsuario   = SesionService.IdUsuario
        };

        var ok = await InformeApi.AgregarObservacionAsync(IdAprendiz, dto);
        if (ok)
        {
            nuevaObs      = "";
            observaciones = await InformeApi.ObtenerObservacionesAsync(IdAprendiz);
        }
        else
        {
            errorObs = "No se pudo guardar la observación. Intente de nuevo.";
        }
        guardandoObs = false;
    }
}
