@page "/passwordchange"
@attribute [AllowAnonymous]
@using System.Diagnostics
@using AdsoLabs.Application.DTOs.Auth
@using AdsoLabs.Web.Components.Layout
@using AdsoLabs.Web.Services
@using AdsoLabs.Web.Services.Api
@rendermode InteractiveServer
@layout LoginLayout
@inject NavigationManager nav
@inject SesionService SesionService
@inject AuthApiService AuthApiService

<div class="auth-split">

    <div class="auth-panel-left">
        <img class="auth-logo" src="images/Logo.png" alt="ADSO Labs" />
        <img class="auth-illustration" src="images/humanos.png" alt="" aria-hidden="true" />
        <p class="auth-quote">
            &ldquo;We engineer scalable software with architectural precision,
            turning complex needs into intelligent digital solutions.&rdquo;
        </p>
        <img class="auth-bg" src="images/Gradient_Login.png" alt="" aria-hidden="true" />
    </div>

    <div class="auth-panel-right">
        <div class="auth-card">

            <div class="auth-card-header">
                <h1 class="auth-title">
                    @(SesionService.EsPrimerLogin ? "Establece tu contraseña" : "Recuperar contraseña")
                </h1>
                <p class="auth-subtitle">
                    @(SesionService.EsPrimerLogin
                        ? "Es tu primer inicio de sesión. Crea una contraseña segura para continuar."
                        : "Tu cuenta está a unos pasos de ser recuperada. Establece una nueva contraseña.")
                </p>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="inp-new-pass">Nueva contraseña</label>
                <div class="auth-input-group">
                    <i class="bi bi-key"></i>
                    <input id="inp-new-pass" type="password" @bind="password" placeholder="••••••••••••" />
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="inp-confirm-pass">Confirmar contraseña</label>
                <div class="auth-input-group">
                    <i class="bi bi-key-fill"></i>
                    <input id="inp-confirm-pass" type="password" @bind="passwordConfirm" placeholder="••••••••••••" />
                </div>
            </div>

            @if (SesionService.EsPrimerLogin)
            {
                <div class="auth-field auth-field-check">
                    <label class="auth-check-label">
                        <input type="checkbox" @bind="consentimientoAceptado" />
                        He leído y acepto el <a href="docs/aviso-tratamiento-datos.html" target="_blank">Aviso de Tratamiento de Datos Personales</a>.
                    </label>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensaje) && resultado != null)
            {
                var alertCls = resultado.esExitoso ? "auth-alert auth-alert-ok" : "auth-alert auth-alert-error";
                var iconCls  = resultado.esExitoso ? "bi bi-check-circle-fill" : "bi bi-exclamation-circle-fill";
                <div class="@alertCls">
                    <i class="@iconCls"></i>
                    @mensaje
                </div>
            }

            <button class="auth-btn-primary" @onclick="Navegar" disabled="@(cargando || (SesionService.EsPrimerLogin && !consentimientoAceptado))">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <i class="bi bi-shield-check"></i>
                    <span>Cambiar contraseña</span>
                }
            </button>

        </div>
    </div>

</div>


@code {

    string password = "";
    string passwordConfirm = "";
    bool consentimientoAceptado = false;
    string mensaje = "";
    private CambiarPasswordResultadoDto resultado = new();
    private bool cargando = false;

    protected override void OnInitialized()
    {
        if (!SesionService.EsPrimerLogin && !SesionService.PuedeCambiarPassword)
        {
            nav.NavigateTo("/");
        }
    }

    async Task Navegar()
    {
        if (string.IsNullOrEmpty(password) || string.IsNullOrEmpty(passwordConfirm))
        {
            mensaje = "No pueden haber campos vacíos";
            return;
        }

        if (password != passwordConfirm)
        {
            mensaje = "Las contraseñas no coinciden";
            return;
        }

        if (SesionService.EsPrimerLogin && !consentimientoAceptado)
        {
            mensaje = "Debes aceptar el Aviso de Tratamiento de Datos Personales";
            return;
        }

        cargando = true;

        if (SesionService.EsPrimerLogin)
            resultado = await AuthApiService.CambiarPasswordAsync(new CambiarPasswordPrimerLoginDto()
            {
                IdUsuario = SesionService.IdUsuario,
                NuevaPassword = password,
                ConsentimientoAceptado = consentimientoAceptado
            });
        else if (SesionService.PuedeCambiarPassword)
            resultado = await AuthApiService.CambiarPasswordAsync(new CambiarPasswordDto()
            {
                Token = SesionService.TokenRecuperacion,
                NuevaPassword = password
            });
        else
        {
            nav.NavigateTo("/");
            return;
        }

        cargando = false;

        if (resultado.esExitoso)
        {
            mensaje = resultado.Mensaje;
            StateHasChanged();
            await Task.Delay(3000);
            nav.NavigateTo("/");
        }
        else
        {
            mensaje = resultado.Mensaje;
        }
    }
}