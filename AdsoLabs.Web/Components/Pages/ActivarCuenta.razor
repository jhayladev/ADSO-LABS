@page "/activar-cuenta"
@attribute [AllowAnonymous]
@using AdsoLabs.Application.DTOs.Aprendiz
@using AdsoLabs.Application.DTOs.Auth
@using AdsoLabs.Web.Components.Layout
@using AdsoLabs.Web.Services
@using AdsoLabs.Web.Services.Api
@rendermode InteractiveServer
@layout LoginLayout
@inject NavigationManager nav
@inject ActivacionCuentaApiService ActivacionCuentaApiService
@inject SesionService SesionService
@inject NavigationManager navigation

<div class="auth-split">

    <div class="auth-panel-left">
        <img class="auth-logo" src="images/Logo.png" alt="ADSO Labs" />
        <img class="auth-illustration" src="images/seguridad.png" alt="" aria-hidden="true" />
        <p class="auth-quote">
            &ldquo;We engineer scalable software with architectural precision,
            turning complex needs into intelligent digital solutions.&rdquo;
        </p>
        <img class="auth-bg" src="images/Gradient_Login.png" alt="" aria-hidden="true" />
    </div>

    <div class="auth-panel-right">
        <div class="auth-card">

            @if (!enviado)
            {
                <div class="auth-card-header">
                    <h1 class="auth-title">Activa tu cuenta</h1>
                    <p class="auth-subtitle">
                        Ingresa tu número de documento y el correo electrónico
                        al que recibirás el enlace de activación.
                    </p>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="inp-documento">Número de documento</label>
                    <div class="auth-input-group">
                        <i class="bi bi-person-vcard"></i>
                        <input id="inp-documento" type="text" @bind="peticion.NumeroDocumento" placeholder="Ej: 1234567890" />
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="inp-correo-act">Correo electrónico</label>
                    <div class="auth-input-group">
                        <i class="bi bi-envelope-open"></i>
                        <input id="inp-correo-act" type="email" @bind="peticion.Correo" placeholder="usuario@soy.sena.edu.co" />
                    </div>
                </div>

                @if (resultado != null)
                {
                    var alertCls = resultado.esExitoso ? "auth-alert auth-alert-ok" : "auth-alert auth-alert-error";
                    var iconCls  = resultado.esExitoso ? "bi bi-check-circle-fill" : "bi bi-exclamation-circle-fill";
                    <div class="@alertCls">
                        <i class="@iconCls"></i>
                        @resultado.Mensaje
                    </div>
                }

                <button class="auth-btn-primary" onclick="@SolicitarActivacionAsync" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <i class="bi bi-envelope-check"></i>
                        <span>Enviar enlace de activación</span>
                    }
                </button>

                <a class="auth-link" href="/" style="text-align:center;">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            }
            else
            {
                <div class="auth-confirm">
                    <div class="auth-confirm-icon">
                        <i class="bi bi-envelope-check-fill"></i>
                    </div>
                    <h1 class="auth-title" style="font-size:1.5rem;">¡Enlace enviado!</h1>
                    <p>
                        Se envió un enlace de activación a
                        <strong>@peticion.Correo</strong>.
                        Revisa tu bandeja de entrada y sigue las instrucciones
                        para establecer tu contraseña.
                    </p>
                    <a href="/">Volver al inicio de sesión</a>
                </div>
            }

        </div>
    </div>

</div>

@code {

    protected override void OnInitialized()
    {
        if (SesionService.EstaAutenticado)
        {
            navigation.NavigateTo("/logouthandler", forceLoad: true);
        }
    }

}

@code {

    private bool cargando = false;
    private bool enviado = false;
    private ActivarUsuarioResultadoDTO resultado = null;
    private ActivarUsuarioSolicitudDTO peticion = new();

    async Task SolicitarActivacionAsync()
    {
        resultado = null;
        cargando  = true;

        if (string.IsNullOrWhiteSpace(peticion.NumeroDocumento) || string.IsNullOrWhiteSpace(peticion.Correo))
        {
            resultado = new ActivarUsuarioResultadoDTO { esExitoso = false, Mensaje = "No pueden haber campos vacíos." };
            cargando  = false;
            return;
        }

        resultado = await ActivacionCuentaApiService.SolicitarActivacionAsync(peticion);

        if (resultado.esExitoso)
            enviado = true;

        cargando = false;
    }
}
