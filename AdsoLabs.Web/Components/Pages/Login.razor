@page "/"
@using AdsoLabs.Application.DTOs.Auth
@using AdsoLabs.Web.Components.Layout
@using AdsoLabs.Web.Services
@using AdsoLabs.Web.Services.Api
@layout LoginLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject NavigationManager navigation
@inject AuthApiService AuthApiService
@inject SesionService SesionService
@inject IJSRuntime JS

<div class="auth-split">

    <div class="auth-panel-left">
        <img class="auth-logo" src="images/Logo.png" alt="ADSO Labs" />
        <img class="auth-illustration" src="images/computadora.png" alt="" aria-hidden="true" />
        <p class="auth-quote">
            &ldquo;We engineer scalable software with architectural precision,
            turning complex needs into intelligent digital solutions.&rdquo;
        </p>
        <img class="auth-bg" src="images/Gradient_Login.png" alt="" aria-hidden="true" />
    </div>

    <div class="auth-panel-right">
        <div class="auth-card">

            <div class="auth-card-header">
                <h1 class="auth-title">Bienvenido a AdsoLabs</h1>
                <p class="auth-subtitle">
                    Sistema de gestión de aprendices y competencias
                    del programa ADSO — CAA
                </p>
            </div>

            @if (cuentaActivada)
            {
                <div class="auth-alert auth-alert-ok">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>
                        <strong>¡Cuenta activada!</strong> Ingresa con tu correo y tu número de documento como contraseña.
                        Serás redirigido a cambiar tu contraseña al iniciar sesión.
                    </span>
                </div>
            }

            <div class="auth-field">
                <label class="auth-label" for="inp-correo">Correo electrónico</label>
                <div class="auth-input-group">
                    <i class="bi bi-envelope"></i>
                    <input id="inp-correo" type="email" @bind="peticion.Correo" placeholder="usuario@soy.sena.edu.co" />
                </div>
            </div>

            <div class="auth-field">
                <div class="auth-field-row">
                    <label class="auth-label" for="inp-password">Contraseña</label>
                </div>
                <div class="auth-input-group">
                    <i class="bi bi-lock"></i>
                    <input id="inp-password" type="password" @bind="peticion.Password" placeholder="••••••••" />
                </div>
            </div>

            <a class="auth-link" href="/acceso">¿Olvidaste la contraseña?</a>

            @if (!loginExitoso && resultado != null)
            {
                var alertCls = resultado.esExitoso ? "auth-alert auth-alert-ok" : "auth-alert auth-alert-error";
                var iconCls  = resultado.esExitoso ? "bi bi-check-circle-fill" : "bi bi-exclamation-circle-fill";
                <div class="@alertCls">
                    <i class="@iconCls"></i>
                    @resultado.Mensaje
                </div>
            }

            <button class="auth-btn-primary" @onclick="Navegar" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Ingresando...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Iniciar Sesión</span>
                }
            </button>

        </div>
    </div>

</div>

@if (loginExitoso && usuario != null)
{
    <form method="post" action="/loginhandler" id="formHandler">
        <input type="hidden" name="IdUsuario" value="@usuario.IdUsuario" />
        <input type="hidden" name="NombreRol" value="@usuario.NombreRol" />
        <input type="hidden" name="Nombres" value="@usuario.Nombres" />
        <input type="hidden" name="Apellidos" value="@usuario.Apellidos" />
        <input type="hidden" name="Correo" value="@usuario.Correo" />
        <input type="hidden" name="PrimerLogin" value="@(usuario.PrimerLogin ? 1 : 0)" />
        <input type="hidden" name="IdInstructor" value="@usuario.IdInstructor" />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    </form>
}

@code {

    private UsuarioSesionDTO? usuario;
    private LoginResultadoDto? resultado;
    private LoginPeticionDto peticion = new();
    private bool loginExitoso = false;
    private bool cargando = false;
    private bool cuentaActivada = false;
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (SesionService.EstaAutenticado)
            navigation.NavigateTo("/logouthandler", forceLoad: true);

        cuentaActivada = navigation.Uri.Contains("activado=true");
    }

    async Task Navegar()
    {
        cargando = true;

        if (string.IsNullOrEmpty(peticion.Correo) || string.IsNullOrEmpty(peticion.Password))
        {
            resultado = new LoginResultadoDto() { esExitoso = false, Mensaje = "No pueden haber campos vacios" };
            cargando = false;
            return;
        }

        try
        {
            resultado = await AuthApiService.LoginAsync(peticion);
            usuario = resultado.Usuario;
            loginExitoso = resultado.esExitoso;

            if (loginExitoso && usuario != null)
            {
                StateHasChanged();
                await Task.Delay(100);
                await JS.InvokeVoidAsync("eval", "document.getElementById('formHandler').submit()");
            }
        }
        catch
        {
            resultado = new LoginResultadoDto() { esExitoso = false, Mensaje = "Usuario o contraseña incorrectos" };
        }
        finally
        {
            cargando = false;
        }
    }
}
