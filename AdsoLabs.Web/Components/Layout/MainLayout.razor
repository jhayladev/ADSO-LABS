@using AdsoLabs.Web.Services
@inherits LayoutComponentBase
@inject SesionService SesionService
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">

            <div class="topbar-left">
                <div class="user-circle">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="welcome-text">
                    <h5>Bienvenido, @SesionService.Nombres</h5>
                    <span>@subtitulo</span>
                </div>
            </div>

            <div class="topbar-right">
                <PanelNotificaciones />
                <div class="date-circle">
                    @DateTime.Now.Day
                </div>
                <div>
                    <div class="dia">@DateTime.Now.ToString("ddd"),</div>
                    <div class="mes">@DateTime.Now.ToString("MMMM")</div>
                </div>
            </div>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {

    private string subtitulo = string.Empty;

    protected override void OnInitialized()
    {
        ActualizarSubtitulo(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ActualizarSubtitulo(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void ActualizarSubtitulo(string uri)
    {
        var segmento = new Uri(uri).AbsolutePath.Trim('/').ToLowerInvariant();
        var seccion  = segmento.Split('/')[0];

        subtitulo = seccion switch
        {
            _                 => "Panel de gestión del programa ADSO — CAA."
        };
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

}
